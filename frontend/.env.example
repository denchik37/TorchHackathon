# =============================================================================
# Frontend (Next.js) — Vercel or local. Oracle data comes from Hetzner torch-api
# via server-side proxy; never from local filesystem or resolver execution.
# =============================================================================

# --- Public (exposed to browser) ---
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_frontend_api
NEXT_PUBLIC_SUBGRAPH_URL=your_subgraph_url
NEXT_PUBLIC_CONTRACT_ADDRESS=your_contract_address
NEXT_PUBLIC_CONTRACT_ID=your_hedera_contract_id

# --- Server-only (never use NEXT_PUBLIC_ for these) ---
# Required for Oracle page: frontend proxies /api/oracle/runs and /api/oracle/runs/:id to Hetzner.
TORCH_API_BASE=http://YOUR_HETZNER_IP:3001
DASHBOARD_API_TOKEN=your_rotated_secret_token

# --- Optional: Oracle price ---
# If set, /api/oracle/price also fetches from this URL (e.g. Chainlink/Pyth API) for display.
ORACLE_PRICE_URL=
