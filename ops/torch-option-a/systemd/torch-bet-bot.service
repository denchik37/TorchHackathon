# Template: copy to /etc/systemd/system/torch-bet-bot.service
# One-shot daily bet run. Triggered by torch-bet-bot.timer.

[Unit]
Description=Torch daily bet run (oneshot)
After=network.target

[Service]
Type=oneshot
User=torch
WorkingDirectory=/opt/torch-agent-kit-bot
EnvironmentFile=/etc/torch/torch-bet-bot.env
ExecStart=/usr/bin/npm run daily
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
