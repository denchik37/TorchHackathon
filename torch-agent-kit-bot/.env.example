# =============================================================================
# torch-agent-kit-bot — Daily bet agent. Runs on Hetzner; writes run artifacts
# to ./runs (relative to app dir). torch-api reads from same dir via BETTING_RUNS_DIR.
# =============================================================================

# --- Hedera (operator account; single ECDSA key) ---
ACCOUNT_ID=0.0.xxxxx
PRIVATE_KEY=302e...
NETWORK=testnet
TORCH_CONTRACT_ID=0.0.xxxxx

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.2-chat-latest
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_COMPLETION_TOKENS=2048

# --- Forecast / bet ---
CONFIDENCE_PERCENT=60
SYMBOL=HBAR
STAKE_HBAR=0.1
MAX_DAILY_SPEND_HBAR=1
MIN_TARGET_LEAD_SECONDS=86400
DAYS_AHEAD=1

# --- Safety & logging ---
DRY_RUN=true
LOG_LEVEL=info

# --- Contract execution ---
GAS_LIMIT=500000
