# Required — Hedera (Agent Kit style: operator account + private key)
ACCOUNT_ID=0.0.xxxxx
PRIVATE_KEY=302e...
NETWORK=testnet

# Required — Torch contract (Hedera contract id)
TORCH_CONTRACT_ID=0.0.xxxxx

# Required — OpenAI
OPENAI_API_KEY=sk-...

# Optional — OpenAI (GPT-5.2)
OPENAI_MODEL=gpt-5.2-chat-latest
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_COMPLETION_TOKENS=2048

# Optional — Forecast / bet
CONFIDENCE_PERCENT=60
SYMBOL=HBAR
STAKE_HBAR=0.1
MAX_DAILY_SPEND_HBAR=1
MIN_TARGET_LEAD_SECONDS=86400
DAYS_AHEAD=1

# Optional — Safety
DRY_RUN=true
LOG_LEVEL=info

# Optional — Contract execution
GAS_LIMIT=500000
