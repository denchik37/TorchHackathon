# =============================================================================
# Dashboard (torch-agent-kit-bot/dashboard) — Option A: proxies to Hetzner torch-api.
# Does not execute resolver or bot; account/balance from Hedera Mirror.
# =============================================================================

# --- Bot account (read-only; for Account page + Overview). No private key. ---
BOT_ACCOUNT_ID=0.0.XXXXXXXX
BOT_NETWORK=mainnet

# --- Server-only: Hetzner torch-api. Do not use NEXT_PUBLIC_. ---
TORCH_API_BASE=http://YOUR_HETZNER_IP:3001
DASHBOARD_API_TOKEN=your_secret_token
