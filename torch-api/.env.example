# =============================================================================
# torch-api — Read-only API for run artifacts. Runs on Hetzner; dashboard/frontend
# proxy to it with Bearer token. Never returns secrets.
# =============================================================================

PORT=3001
DASHBOARD_API_TOKEN=your_secret_token

# Absolute paths to run artifact directories (must match where bot and resolver write).
BETTING_RUNS_DIR=/opt/torch-agent-kit-bot/runs
RESOLVER_RUNS_DIR=/opt/torch-oracle-resolver/runs
