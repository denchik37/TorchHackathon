# =============================================================================
# torch-oracle-resolver — Runs ONLY on Hetzner. Performs on-chain writes; private key
# must never be deployed to Vercel or used in the frontend.
# =============================================================================

# --- Network & contract ---
NETWORK=testnet
ADMIN_ACCOUNT_ID=0.0.xxxxx
ADMIN_PRIVATE_KEY=302e...
TORCH_CONTRACT_ID=0.0.xxxxx
SUBGRAPH_URL=https://...

# --- Price source & safety ---
COINGECKO_API_KEY=
PRICE_SOURCE_MODE=hybrid
ORACLE_PROVIDER=chainlink
MAX_PRICE_DIVERGENCE_PCT=1.0
FINALIZATION_BUFFER_SECONDS=120
MAX_TIMESTAMPS_PER_TX=50
MAX_BUCKETS_PER_RUN=25
MAX_PROCESS_BATCH_TX_PER_BUCKET=20
DRY_RUN=true

# --- Backlog ---
BACKLOG_START_FROM=auto
BACKLOG_MAX_AGE_DAYS=90
RESOLVE_CONCURRENCY=1

# --- Persistence (production: use /var/lib/torch paths) ---
# If unset, resolver uses ./runs and ./state.json relative to cwd (local dev only).
RESOLVER_RUNS_DIR=/var/lib/torch/resolver-runs
RESOLVER_STATE_PATH=/var/lib/torch/resolver-state/state.json

# --- Optional ---
RESOLVER_TRIGGER_SECRET=
LOG_LEVEL=info
RESOLVE_LOOP_INTERVAL_MS=

# --- CoinGecko throttling and cache ---
COINGECKO_MIN_DELAY_MS=1200
COINGECKO_MAX_RETRIES=6
COINGECKO_BACKOFF_BASE_MS=800
COINGECKO_BACKOFF_MAX_MS=15000
COINGECKO_JITTER_PCT=0.2
COINGECKO_CACHE_TTL_DAYS=3650
COINGECKO_CACHE_MAX_ENTRIES=20000
