{
  "name": "torch-oracle-resolver",
  "version": "1.0.0",
  "description": "Backlog-capable auto resolver for Torch Prediction Market (CoinGecko + Oracle check)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "resolve:once": "npx tsx src/runner/resolve-once.ts",
    "resolve:loop": "npx tsx src/runner/resolve-loop.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.52.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "graphql-request": "^6.1.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
