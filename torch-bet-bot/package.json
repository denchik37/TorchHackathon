{
  "name": "torch-bet-bot",
  "version": "1.0.0",
  "description": "Daily betting agent: fetches HBAR price forecasts (OpenAI), converts to Torch bet params, submits onchain to Hedera.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "daily": "tsx src/runner/run-daily-bets.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "ethers": "^6.13.0",
    "openai": "^4.73.0",
    "pino": "^9.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
