# ===========================================
# Torch Bet Bot – environment variables
# Copy to .env and fill values. Never commit .env.
# ===========================================

# --- Forecast provider: openai (default) | numinous
FORECAST_PROVIDER=openai

# OpenAI (required when FORECAST_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Numinous (required when FORECAST_PROVIDER=numinous). Do not commit; use env on server.
# NUMINOUS_API_KEY=...

# --- Hedera / EVM
RPC_URL=https://mainnet.hashio.io/api
CHAIN_ID=295
TORCH_CONTRACT_ADDRESS=0x...

# Wallet private key (hot wallet for bot). Never commit.
PRIVATE_KEY=0x...

# --- Spend guardrails (HBAR)
BET_AMOUNT_HBAR=0.1
MAX_DAILY_SPEND_HBAR=1
# Optional: cap per single bet
# MAX_BET_AMOUNT_HBAR=0.5

# --- Hedera EVM / Torch
# msg.value decimals (default 18 = weibar). Min non-zero is 1 tinybar = 10^10 weibar.
NATIVE_VALUE_DECIMALS=18
# Min seconds from now to first target (default 86400 = 1 day). Prevents "Target too soon" revert.
MIN_TARGET_LEAD_SECONDS=86400
# Torch expects 8-decimal fixed-point for priceMin/priceMax (same as frontend).
PRICE_DECIMALS=8

# --- OpenAI (ChatGPT-style GPT-5.2: max_completion_tokens only, no temperature)
# OPENAI_MODEL=gpt-5.2-chat-latest
# OPENAI_REASONING_EFFORT=high
# OPENAI_MAX_COMPLETION_TOKENS=2048

# --- Safety
# Set to true to log and store run without sending transactions
DRY_RUN=false

# --- Optional
# FORECAST_CONCURRENCY=2
# HTTP_TIMEOUT_MS=30000
# LOG_LEVEL=info
